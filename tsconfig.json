{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./node_modules/.prisma/client/default"],
      "@prisma/client/*": ["./node_modules/.prisma/client/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
